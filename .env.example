# Machine-local paths for the build. Copy this file to .env and edit it -- .env
# is gitignored, so your paths stay yours.

# Where the build writes Rance10.ain, Rance10EX.ex and Rance10Pact.afa. This is
# the game's own directory, the one holding Rance10.exe. Writing into
# "C:\Program Files (x86)\..." needs an elevated terminal, or "Full Access" for
# "Everyone" on that folder.
GAME_DIR=C:\Program Files (x86)\AliceSoft\ランス１０

# alice-tools: https://github.com/nunuhara/alice-tools
ALICE_EXE=C:\alice-tools\alice.exe

# Optional. `ar pack` has historically been run with a different build of
# alice-tools than the rest; leave it out to use ALICE_EXE for everything.
#ALICE_EXE_PACK=C:\alice-tools-0.13.0\alice.exe

# Optional. Which dialogue translation `npm run regenerate-ain` builds when you
# do not pass --variant; one of the folder names under variants/, "gpt" if
# unset. See docs/translation-variants.md.
#TRANSLATION_VARIANT=gpt
